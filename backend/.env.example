# Copy this file to .env and fill in values from your Neon project.
# Use the pooled or direct Neon JDBC URL, including sslmode=require.
NEON_JDBC_URL=
NEON_DB_USERNAME=
NEON_DB_PASSWORD=

# Generate locally with: openssl rand -base64 48
HF_JWT_SECRET=

EUREKA_DEFAULT_ZONE=http://localhost:8761/eureka/
HF_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000